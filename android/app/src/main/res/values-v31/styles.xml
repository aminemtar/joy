<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash shown before Flutter initializes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/joy_launch</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#243E86</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
    </style>
</resources>
